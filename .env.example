# =============================================================================
# Environment variables — salin ke .env.local untuk pengembangan lokal
# =============================================================================
# TIDAK ADA satu pun nilai di bawah ini yang boleh diberi awalan NEXT_PUBLIC_.
# Semuanya hanya dibaca di sisi server.

# --- Supabase ----------------------------------------------------------------
# Settings -> API pada dashboard Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Sesi --------------------------------------------------------------------
# Minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- GitHub OAuth (dipakai untuk "Login with GitHub") -------------------------
# Bisa memakai OAuth credentials milik GitHub App yang sama.
# Callback URL: {APP_URL}/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub App (pembuatan repo & pembacaan hasil Actions) --------------------
GITHUB_APP_ID=123456
# PEM lengkap. Di Vercel, tempel dengan newline diganti "\n".
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"
# Angka installation id (lihat DEPLOYMENT.md untuk cara mendapatkannya)
GITHUB_APP_INSTALLATION_ID=12345678
# Secret webhook yang diset pada GitHub App
GITHUB_WEBHOOK_SECRET=ganti-dengan-string-acak
# Organisasi tempat repo mahasiswa dibuat
GITHUB_ORG=nama-organisasi-anda

# --- Bootstrap admin ----------------------------------------------------------
# Username GitHub (dipisah koma) yang otomatis jadi SUPER_ADMIN saat login.
GITHUB_SUPER_ADMINS=itsdimasrizki

# --- URL aplikasi -------------------------------------------------------------
APP_URL=http://localhost:3000
